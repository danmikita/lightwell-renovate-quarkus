{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["maven"],
  "onboarding": false,
  "requireConfig": "optional",
  "packageRules": [
    {
      "description": "Disable updates for all packages by default to keep demo execution under 30s",
      "matchPackagePatterns": ["*"],
      "enabled": false
    },
    {
      "description": "Remediate vulnerable commons-compress via Red Hat Lightwell Network - Remediated",
      "matchPackageNames": ["org.apache.commons:commons-compress"],
      "enabled": true,
      "ignoreUnstable": false,
      "separateMinorPatch": true,
      "registryUrls": [
        "https://packages.redhat.com/lightwell/java/remediated/"
      ]
    }
  ]
}
